<?xml version="1.0" encoding="utf-8"?>
<!-- Settings only: selected values and D-pad focus have deliberately different states. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item><shape><corners android:radius="14dp"/><solid android:color="#FFF4E3B8"/></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><corners android:radius="12dp"/><solid android:color="#FFE1AB35"/></shape></item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><corners android:radius="14dp"/><solid android:color="#FFE1AB35"/></shape></item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp"><shape><corners android:radius="12dp"/><solid android:color="#FF34204A"/></shape></item>
        </layer-list>
    </item>
    <item><shape><corners android:radius="14dp"/><solid android:color="#D921172D"/><stroke android:width="1dp" android:color="#665B486E"/></shape></item>
</selector>
